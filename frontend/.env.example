# --- Firebase client SDK (safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only - NEVER expose) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key in quotes; literal \n escapes are handled in code.
FIREBASE_PRIVATE_KEY=""

# --- Google Maps / Places (server only - NEVER expose) ---
# Used server-side for Places search and the /api/photo proxy. Restrict this
# key to the Places API in Google Cloud and set a billing quota cap.
GOOGLE_MAPS_API_KEY=

# --- Twilio (server only - NEVER expose) - SMS + calling ---
# From the Twilio Console. SMS/calls are disabled until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Recommended: a Messaging Service SID (required for A2P 10DLC). If unset,
# TWILIO_PHONE_NUMBER is used as the SMS sender.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# Public base URL Twilio can reach for webhooks (e.g. https://app.b2lead.com).
# Used to build status/inbound callback URLs.
NEXT_PUBLIC_APP_URL=

# Browser calling (Twilio Voice). Create an API Key/Secret and a TwiML App in
# the Twilio Console; point the TwiML App's Voice URL at /api/voice/twiml.
# Calling stays disabled until these are set.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
