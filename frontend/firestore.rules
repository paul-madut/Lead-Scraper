rules_version = '2';

// Lead-Scraper / B2Lead Firestore security rules.
// Money-bearing collections are server-only (the Admin SDK bypasses rules).
// CRM collections are workspace-scoped: a user may only touch data in a
// workspace they are a member of. Membership itself is server-granted.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership doc id is "<workspaceId>__<userId>".
    function isMember(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/memberships/$(workspaceId + '__' + request.auth.uid));
    }

    // --- Money / server-only ---
    match /tokens/{userId} {
      allow read, write: if false;
    }
    match /searchSessions/{sessionId} {
      allow read, write: if false;
    }
    match /searchQueries/{queryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- Tenancy (server-managed) ---
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow write: if false;
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- CRM (workspace members) ---
    match /contacts/{contactId} {
      allow read: if isMember(resource.data.workspaceId);
      allow create: if isMember(request.resource.data.workspaceId)
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isMember(resource.data.workspaceId);
    }
    match /activities/{activityId} {
      // Append-only: create + read only, no edits or deletes.
      allow read: if isMember(resource.data.workspaceId);
      allow create: if isMember(request.resource.data.workspaceId);
      allow update, delete: if false;
    }

    // --- Messaging (server-written; members read) ---
    match /numbers/{numberId} {
      allow read: if isMember(resource.data.workspaceId);
      allow write: if false;
    }
    match /conversations/{conversationId} {
      allow read: if isMember(resource.data.workspaceId);
      allow write: if false;
    }
    match /messages/{messageId} {
      allow read: if isMember(resource.data.workspaceId);
      allow write: if false;
    }
    match /calls/{callId} {
      allow read: if isMember(resource.data.workspaceId);
      allow write: if false;
    }

    // --- Sequences (members author; enrollments are engine-driven) ---
    match /sequences/{sequenceId} {
      allow read: if isMember(resource.data.workspaceId);
      allow create: if isMember(request.resource.data.workspaceId)
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isMember(resource.data.workspaceId);
    }
    match /enrollments/{enrollmentId} {
      allow read: if isMember(resource.data.workspaceId);
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
